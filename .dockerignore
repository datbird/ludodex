# Keep the distributable image clean: no local data, secrets, or build cruft.

# vcs / editor
.git
.gitignore
*.md
!README.md

# python
__pycache__/
**/__pycache__/
*.pyc
.venv/
venv/

# node / built frontend (dist is rebuilt in the web stage)
web/node_modules/
web/dist/

# --- local data / state / secrets — must NEVER be baked into the image ---
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite.bak*
*.bak-*
*.tsv
*.json.bak
media/
device-media/
.ea/
.gog/
.psn/
.xbox/
.steam/
.nintendo/
tokens.json
*service-account*.json
*serviceaccount*.json
firebase*.json
*-sa.json
.env
.env.*
!.env.example
*.log
*.pid
*.err
.prev_keys
.cur_keys
.new_keys
.gogchk
server.pid

# --- development-time material: needed in a CHECKOUT, never at runtime ---
# The image is what the app needs to RUN. Everything below is what a developer needs,
# and it was all being copied in by `COPY . /app`: ~130 test scripts plus a 2 MB image
# corpus, the verify_*.py one-offs (one of which used to rsync /data), the agent skills,
# and the test runner. scripts/ itself stays — ssmirror-loop.sh runs in the container.
tests/
ludodex/verify_*.py
skills/
scripts/run_tests.sh

# run artifacts that must never be baked in (ss_mirror writes these into the data dir;
# a copy in the repo root is always a stray)
ss-missing-ids.json
ss-missing-ids.done
*-missing-ids.json
.itchchk
.eachk
