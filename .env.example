# ludodex — container configuration. Copy to `.env` and fill in what you use.
# Everything here is OPTIONAL: any value can instead be set in the in-app
# Settings (persisted to the /data volume). Secrets are never committed —
# .env is gitignored. ludodex never reads a secret store at runtime.

# --- where durable state lives inside the container (leave as-is normally) ---
LUDODEX_DATA=/data
TZ=UTC

# --- Sources: establish what you own -----------------------------------------
STEAM_API_KEY=
ITCH_API_KEY=
EA_REMID=                 # EA "remember me" cookie (durable login)
PSN_NPSSO=                # PSN npsso token (one-time, to mint refresh tokens)
# (GOG / Epic / Xbox use interactive OAuth — do those from the Settings UI;
#  the resulting tokens persist under /data.)

# --- Providers: enrich metadata / art ----------------------------------------
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAMGRIDDB_API_KEY=
SS_DEVID=                 # ScreenScraper developer id  (optional override)
SS_DEVPASSWORD=           # ScreenScraper developer password
SS_SSID=                  # ScreenScraper user account
SS_SSPASSWORD=            # ScreenScraper user password

# --- AI (BYOAI) --------------------------------------------------------------
# Pick the provider(s) you want; set the matching API key in the Settings UI
# (stored in /data/config.sqlite). These two select which provider is active:
AI_PROVIDER=              # anthropic | openai | openrouter | gemini
AI_VISION_PROVIDER=       # provider used for image/box-art analysis

# --- optional sync target ----------------------------------------------------
POCKETBASE_PASSWORD=

# --- tuning (optional) -------------------------------------------------------
STEAM_STORE_COOLDOWN_MS=  # rate-limit backoff for the Steam store
GOG_COOLDOWN_MS=          # rate-limit backoff for GOG

# Scratch dir. Blank means $LUDODEX_DATA/tmp. EMPTIED ON EVERY START, so it may not be
# the data dir or a parent of it; the entrypoint refuses those and only wipes a
# directory carrying its own .ludodex-scratch marker.
LUDODEX_TMP=
# Art repo. Blank means auto-detect a WRITABLE mount at /media. Mount a read-only ROM
# share somewhere else (the compose file uses /library:ro) or it would be adopted here.
LUDODEX_MEDIA=
